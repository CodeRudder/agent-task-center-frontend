FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx vite build

FROM nginx:alpine AS stage-1

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /app/logs

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
